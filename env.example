# =====================================================================
# このファイルをコピーして「.env」という名前で保存し、実際の値を入力してください。
#   cp .env.example .env
#
# .env はローカルでのテスト実行用です。.gitignore に含まれているため
# Git にはコミットされません。
#
# GitHub Actions で自動実行する場合は、.env を使わず
# リポジトリの Settings → Secrets and variables → Actions に
# 同じ名前で1つずつ登録してください（README.md 参照）。
# =====================================================================

# --- Google Gemini API ---
# 取得先: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Buffer API ---
# 取得先: https://publish.buffer.com/settings/api （Settings → API → Generate Access Token）
BUFFER_API_KEY=
# 下記2つは scripts/find_buffer_ids.py を実行すると一覧表示されます
BUFFER_ORGANIZATION_ID=
BUFFER_CHANNEL_ID=

# --- Cloudinary（生成した画像を Buffer に渡せる公開URLにするためのホスティング） ---
# 取得先: https://cloudinary.com/users/register/free 登録後の Dashboard に表示されます
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cloudflare Workers AI（画像生成。無料枠: 10,000 neurons/日） ---
# 取得先: Cloudflareダッシュボード → 左メニュー「Workers AI」→「Use REST API」→
#         「Create a Workers AI API Token」で発行。Account IDも同じ画面に表示されます。
# 詳細: https://developers.cloudflare.com/workers-ai/get-started/rest-api/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
